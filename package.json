{
  "name": "platform-kit-marketing",
  "private": true,
  "type": "module",
  "version": "0.11.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && node scripts/generate-sitemap.mjs && node scripts/check-asset-paths.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && astro check",
    "playwright:install": "playwright install chromium",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:seo": "node tests/seo.mjs",
    "test:a11y": "node tests/a11y.mjs",
    "test:lead-forms": "node tests/lead-forms.mjs",
    "test:visual": "node tests/visual.mjs",
    "test:visual:gate": "node tests/visual-gate.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm test && pnpm build && pnpm test:seo && pnpm test:a11y",
    "cms:config": "node --experimental-strip-types scripts/generate-cms-config.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/tailwind": "^5.1.4",
    "@singleton-sd/tokens": "1.3.0",
    "astro": "^4.16.18",
    "tailwindcss": "^3.4.15"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@types/pngjs": "^6.0.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0"
  }
}
